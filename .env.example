# ─────────────────────────────────────────────────────────────────────────────
# Beyond the Limits 2026: environment variables
# Copy to .env for local development. On Vercel, set these per environment
# (Preview = staging, Production = production). NEVER commit real values.
# Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# local | staging | production. Live Razorpay keys are refused unless this is "production".
DEPLOY_ENV=local
APP_URL=http://localhost:3000

# Supabase Postgres. Use the pooled (transaction-mode) URL for the app and the direct URL for migrations.
DATABASE_URL=postgresql://btl:btl_local_only@localhost:5544/btl
# Direct (non-pooled) connection for `prisma migrate deploy`. Optional locally.
DIRECT_URL=
DB_POOL_MAX=10

# Field encryption for personal data (AES-256-GCM). Comma-separated keyId:base64key (32 bytes).
# To rotate: add a new key, point PII_ENC_ACTIVE_KEY at it, keep the old one until re-encrypted.
PII_ENC_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64_KEY
PII_ENC_ACTIVE_KEY=k1
# Keyed HMAC for blind indexes (email/phone lookups). Changing it requires re-indexing.
PII_INDEX_KEY=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
# Signs ticket QR tokens. Changing it invalidates every issued ticket.
QR_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
# Signs the booking-access cookie.
ACCESS_COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
# Vercel Cron sends this as a Bearer token to /api/cron/*.
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_24_CHARS

# Payments. "fake" is for local development and tests only (refused in production).
PAYMENT_PROVIDER=razorpay
# Test keys: staging and production (production starts in TEST mode until the go-live gate passes).
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
# Live keys: production ONLY. Used only after the admin switches to LIVE and the checklist passes.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# Email (Resend). Without a key locally, emails are written to .dev-mail/.
RESEND_API_KEY=
EMAIL_FROM="Beyond the Limits <tickets@yourdomain.in>"
ADMIN_ALERT_EMAIL=

# Cloudflare Turnstile. These are Cloudflare's documented always-pass test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis (rate limiting). Required on staging and production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
